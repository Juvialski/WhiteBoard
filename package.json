{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node server.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "if command -v java >/dev/null 2>&1; then npx --yes firebase-tools@15.24.0 emulators:exec \"vitest run\"; else echo 'Java not found, running non-emulator tests only' && vitest run --exclude '**/emulator/**' --exclude '**/rules/**'; fi",
    "test:rules": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore \"vitest run src/rules\"",
    "test:persistence": "npx --yes firebase-tools@15.24.0 emulators:exec --only firestore,auth \"vitest run src/services/emulator\"",
    "admin:grant": "tsx scripts/set-admin-claim.ts grant",
    "admin:revoke": "tsx scripts/set-admin-claim.ts revoke"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "vite": "^6.2.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  }
}
