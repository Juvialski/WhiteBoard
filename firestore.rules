rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isBoardOwner(boardData) {
      return isAuthenticated() && boardData.ownerUid == request.auth.uid;
    }

    function aclFields() {
      return [
        "ownerUid",
        "editorUids",
        "viewerUids",
        "accessMode",
        "studentsCanWrite"
      ];
    }

    function storageLayoutFields() {
      return [
        "schemaVersion",
        "shardLayoutVersion",
        "shardCount",
        "migrationStatus",
        "status"
      ];
    }

    function protectedManagementFields() {
      return [
        "ownerUid",
        "editorUids",
        "viewerUids",
        "accessMode",
        "studentsCanWrite",
        "schemaVersion",
        "shardLayoutVersion",
        "shardCount",
        "migrationStatus",
        "status"
      ];
    }

    function changesProtectedManagementFields() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(protectedManagementFields());
    }

    function isBoardManager(boardData) {
      return isAdmin() || isBoardOwner(boardData);
    }

    function isRecoverableLegacyBoard(boardData) {
      return boardData is map && (
        !boardData.keys().hasAll(["ownerUid", "schemaVersion"]) ||
        boardData.schemaVersion < 2 ||
        boardData.keys().hasAny(["chunkIds"])
      );
    }

    function canReadBoardData(boardData) {
      return isAdmin() || (isAuthenticated() && (
        isRecoverableLegacyBoard(boardData) ||
        boardData.ownerUid == request.auth.uid ||
        (boardData.editorUids is list && request.auth.uid in boardData.editorUids) ||
        (boardData.viewerUids is list && request.auth.uid in boardData.viewerUids) ||
        boardData.accessMode == 'link-view' ||
        boardData.accessMode == 'link-edit'
      ));
    }

    function canWriteBoardData(boardData) {
      return isAdmin() || (isAuthenticated() && (
        boardData.ownerUid == request.auth.uid ||
        (boardData.editorUids is list && request.auth.uid in boardData.editorUids) ||
        (boardData.accessMode == 'link-edit' && boardData.studentsCanWrite == true)
      ));
    }

    function getBoardData(boardId) {
      return get(/databases/$(database)/documents/whiteboards/$(boardId)).data;
    }

    function canReadBoard(boardId) {
      return canReadBoardData(getBoardData(boardId));
    }

    function canWriteBoard(boardId) {
      return canWriteBoardData(getBoardData(boardId));
    }

    function canDeleteBoard(boardId) {
      return isAdmin() || isBoardOwner(getBoardData(boardId));
    }

    function canRecoverLegacyBoard(boardId) {
      return isAuthenticated() && isRecoverableLegacyBoard(getBoardData(boardId));
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Whiteboards collection rules
    match /whiteboards/{boardId} {
      allow get: if canReadBoardData(resource.data);
      // Compatibility listing is temporarily retained so pre-ACL boards can be
      // discovered and claimed. The old production app listed this collection
      // globally, and those documents have no ownerUid to query securely.
      allow list: if isAdmin() || (isAuthenticated() && request.query.limit <= 200);
      allow create: if isAuthenticated() 
        && isValidId(boardId) 
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if (
        canWriteBoardData(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          !changesProtectedManagementFields()
          || isBoardManager(resource.data)
        )
      ) || (
        // One-time compatibility claim: an authenticated user opening a legacy
        // board may copy it into the current schema without deleting old data.
        isAuthenticated()
        && isRecoverableLegacyBoard(resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 3
        && request.resource.data.shardLayoutVersion == 2
        && request.resource.data.shardCount == 160
        && request.resource.data.status == 'ready'
      );
      allow delete: if canDeleteBoard(boardId);

      // Subcollection: stateShards (modern sharded board state)
      match /stateShards/{shardId} {
        allow read: if canReadBoard(boardId);
        allow write: if canWriteBoard(boardId) || canRecoverLegacyBoard(boardId);
      }

      // Subcollection: stateShardsV3 (schema version 3 sharded board state)
      match /stateShardsV3/{shardId} {
        allow read: if canReadBoard(boardId);
        allow write: if canWriteBoard(boardId) || canRecoverLegacyBoard(boardId);
      }

      // Subcollection: assets (base64 binary assets stored in Firestore)
      match /assets/{assetId} {
        allow read: if canReadBoard(boardId);
        allow create: if (canWriteBoard(boardId) || canRecoverLegacyBoard(boardId))
          && request.resource.data.assetId == assetId
          && request.resource.data.encoding == "base64"
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 750000
          && request.resource.data.encodedByteSize is int
          && request.resource.data.encodedByteSize <= 750000
          && request.resource.data.mimeType is string
          && request.resource.data.contentHash is string;

        allow update: if (canWriteBoard(boardId) || canRecoverLegacyBoard(boardId))
          && request.resource.data.assetId == assetId
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 750000;

        allow delete: if canWriteBoard(boardId) || canRecoverLegacyBoard(boardId);
      }

      // Subcollection: presence
      match /presence/{userId} {
        allow read: if canReadBoard(boardId);
        allow write: if isAuthenticated() && request.auth.uid == userId && canReadBoard(boardId);
      }

      // Historical chunk model used by older deployed clients. Read access is
      // retained only for authenticated compatibility recovery.
      match /stateChunks/{chunkId} {
        allow read: if canReadBoard(boardId);
        allow write: if isAdmin();
      }

      // Legacy elements are readable during one-time recovery but remain
      // immutable to normal clients, so original data cannot be destroyed.
      match /elements/{elementId} {
        allow read: if isAdmin() || canRecoverLegacyBoard(boardId);
        allow write: if isAdmin();
      }

      // Subcollection: live collaborator cursors (Deprecated)
      match /cursors/{cursorId} {
        allow read: if canReadBoard(boardId);
        allow write: if isAuthenticated() && isValidId(cursorId) && canWriteBoard(boardId);
      }
    }

    // Global User Presence rules: strict user isolation with admin visibility and delete
    match /presence/{userId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.id == request.auth.uid;
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Admin Settings rules
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
