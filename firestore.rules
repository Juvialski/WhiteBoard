rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for validating types and lengths
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Returns true if the current requester is the verified administrator al.matubis17@gmail.com
    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email == 'al.matubis17@gmail.com' 
        && request.auth.token.email_verified == true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Whiteboards collection rules
    match /whiteboards/{boardId} {
      allow read: if true;
      allow create, update, delete: if isValidId(boardId);

      // Subcollection: stateChunks (modern chunked board state)
      match /stateChunks/{chunkId} {
        allow read: if true;
        allow create, update, delete: if isValidId(boardId) && isValidId(chunkId);
      }

      // Legacy subcollection: elements (read-only for migration)
      match /elements/{elementId} {
        allow read: if true;
        allow create, update, delete: if isValidId(boardId) && isValidId(elementId);
      }

      // Subcollection: live collaborator cursors
      match /cursors/{cursorId} {
        allow read: if true;
        allow create, update, delete: if isValidId(cursorId);
      }
    }

    // Global User Presence rules
    match /presence/{userId} {
      allow read: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // Admin Settings rules
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
