rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null 
        && request.auth.token.email == 'al.matubis17@gmail.com' 
        && request.auth.token.email_verified == true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Whiteboards collection rules
    match /whiteboards/{boardId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isValidId(boardId);
      allow delete: if isAuthenticated() && isValidId(boardId);

      // Subcollection: stateChunks (modern chunked board state)
      match /stateChunks/{chunkId} {
        allow read: if true;
        allow write: if isAuthenticated() && isValidId(boardId) && isValidId(chunkId);
      }

      // Legacy subcollection: elements (READ ONLY for client migration)
      match /elements/{elementId} {
        allow read: if true;
        allow write: if false; // Strictly block all client writes to legacy elements
      }

      // Subcollection: live collaborator cursors
      match /cursors/{cursorId} {
        allow read: if true;
        allow write: if isAuthenticated() && isValidId(cursorId);
      }
    }

    // Global User Presence rules
    match /presence/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && isValidId(userId);
    }

    // Admin Settings rules
    match /admin_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
